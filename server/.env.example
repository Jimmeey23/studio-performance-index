# ── AI engine ────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Models used by the automatic router (fast lookups / standard analysis / deep diagnosis & forecasts).
# Change these if your account uses different model ids.
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_MODEL_BALANCED=claude-sonnet-5-5
ANTHROPIC_MODEL_DEEP=claude-opus-5-5
# Extended thinking (on/off) and thinking budgets per tier, in tokens. Cheapest model first; Opus only for complex reasoning.
AI_THINKING=on
AI_THINK_FAST=5000
AI_THINK_BALANCED=14000
AI_THINK_DEEP=28000
# Newer models think adaptively — effort per tier (low / medium / high / xhigh / max)
AI_EFFORT_FAST=medium
AI_EFFORT_BALANCED=high
AI_EFFORT_DEEP=xhigh

# ── Google Sheets (service account JSON key) ─────────────────
GOOGLE_APPLICATION_CREDENTIALS=./config/service-account.json
# Minutes between automatic syncs (0 = off)
SYNC_INTERVAL_MINUTES=60

# ── Database (Neon) ──────────────────────────────────────────
# Postgres connection string from the Neon console (Connection details → pooled or direct).
# When set, users, saved reports, reviews, layouts, designs, prefs, admin config and targets persist in Neon.
# Leave empty to keep everything in the local data/app.duckdb file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# ── App ──────────────────────────────────────────────────────
PORT=8787
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=jimmeey@physique57india.com
ADMIN_PASSWORD=choose-a-strong-password
# true = no login (single-user local use only)
AUTH_DISABLED=false

# Chapter video explainers (optional) — NotebookLM via https://github.com/teng-lin/notebooklm-py
# Install the CLI on the server (needs Python 3.10+): pipx install notebooklm-py
# Then run `notebooklm login` once locally and paste the resulting storage JSON here (one account; jobs run one at a time).
NOTEBOOKLM_BIN=notebooklm
NOTEBOOKLM_AUTH_JSON=

# Blomp object storage for generated videos (S3-compatible; keys from https://dashboard.blomp.com/dashboard/s3-keys)
BLOMP_S3_ENDPOINT=https://storage.blomp.com
BLOMP_ACCESS_KEY_ID=
BLOMP_SECRET_ACCESS_KEY=
BLOMP_BUCKET=
BLOMP_REGION=us-east-1
BLOMP_PREFIX=p57-bi
