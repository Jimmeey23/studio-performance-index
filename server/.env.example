# ── AI engine ────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Models used by the automatic router (fast lookups / standard analysis / deep diagnosis & forecasts).
# Change these if your account uses different model ids.
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_MODEL_BALANCED=claude-sonnet-5-5
ANTHROPIC_MODEL_DEEP=claude-opus-5-5
# Extended thinking (on/off) and thinking budgets per tier, in tokens. Cheapest model first; Opus only for complex reasoning.
AI_THINKING=on
AI_THINK_FAST=5000
AI_THINK_BALANCED=14000
AI_THINK_DEEP=28000
# Newer models think adaptively — effort per tier (low / medium / high / xhigh / max)
AI_EFFORT_FAST=medium
AI_EFFORT_BALANCED=high
AI_EFFORT_DEEP=xhigh

# ── Google Sheets (service account JSON key) ─────────────────
GOOGLE_APPLICATION_CREDENTIALS=./config/service-account.json
# Minutes between automatic syncs (0 = off)
SYNC_INTERVAL_MINUTES=60

# ── App ──────────────────────────────────────────────────────
PORT=8787
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=jimmeey@physique57india.com
ADMIN_PASSWORD=choose-a-strong-password
# true = no login (single-user local use only)
AUTH_DISABLED=false
