  "leads": {
    "_doc": "Lead status definitions and the governed source → channel grouping used everywhere leads are reported. Sources are matched case-insensitively: exact names first, then regex patterns, in the order listed; anything unmatched falls into channel_fallback.",
    "qualified_statuses": [
      "Trial Scheduled",
      "Trial Completed",
      "Won"
    ],
    "qualified_definition": "A lead is qualified once it shows genuine buying intent: it has a trial scheduled or completed, has bought (Won / converted), or its trial status shows a completed trial.",
    "disqualified_statuses": [
      "Disqualified"
    ],
    "disqualified_definition": "A lead is disqualified when the team has marked it as not a fit (CRM status Disqualified) — typically invalid contact details, outside the studio's catchment, language barrier or a non-relevant enquiry.",
    "lost_statuses": [
      "Lost"
    ],
    "lost_definition": "A lead is lost when it was a genuine prospect but did not proceed (CRM status Lost) — e.g. not interested, pricing, timings or chose another option.",
    "unresponsive_statuses": [
      "Unresponsive"
    ],
    "unresponsive_definition": "The lead has not responded to follow-ups (CRM status Unresponsive).",
